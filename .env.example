# Vercel Blob read/write token — from the Vercel dashboard (Storage → Blob).
# Used by the sync script to write workouts/db.json + badge images,
# and by the site to locate db.json at request time.
BLOB_READ_WRITE_TOKEN=

# OpenAI API key — used ONLY by the local sync script to generate
# workout-type badge images (gpt-image-1). Never deployed to Vercel.
OPENAI_API_KEY=

# Optional: absolute path to a local db.json for dev preview
# (e.g. /tmp/workouts-db.json written by --dry-run). Skips Blob entirely.
# WORKOUTS_DB_LOCAL=
